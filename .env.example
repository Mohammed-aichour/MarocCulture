# Copiez ce fichier en .env.local et renseignez vos clés (gratuites sur les sites indiqués).

# OpenWeather — https://openweathermap.org/api
REACT_APP_OPENWEATHER_ID=your_openweather_api_key

# Pixabay — https://pixabay.com/api/docs/
REACT_APP_PIXABAY_KEY=your_pixabay_api_key


# Wikipédia (fr) et REST Countries : aucune clé requise
